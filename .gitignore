# Node
node_modules
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Tauri
src-tauri/target
# tauri-build が capabilities/プラグインから毎ビルド再生成する。追跡しない。
src-tauri/gen/schemas

# Claude Code。領域別ルール（.claude/rules/）はチームで共有するため追跡する。
# グローバル ignore（~/.gitignore）が .claude/ を丸ごと除外しているので、ここで打ち消す
# （親ディレクトリが除外されたままだと配下を再包含できない）。
!.claude/
.claude/*
!.claude/rules/
# ローカル設定は追跡しない（*.local では .local.json にマッチしないため明示）
.claude/settings.local.json

# Secrets / credentials（安全網: 誤って作業ツリーに置いても追跡しない）
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
